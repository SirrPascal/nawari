  "description": "Monitors telemetry completeness, retention compliance (120h FIFO), and identity confidence.",
  "tags": [
    "nawari",
    "governance",
    "coverage",
    "retention"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet Coverage Summary (34 Candidates)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "ICMP Availability Coverage",
      "type": "gauge",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "PA67C5EADE9207728"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 34,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 34
              }
            ]
          }
        }
      },
      "targets": [
        {
          "group": {
            "filter": "Network Devices"
          },
          "host": {
            "filter": "/.*/"
          },
          "item": {
            "filter": "ICMP ping"
          },
          "mode": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Syslog Association Coverage",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "count_over_time({source=\"solarwinds\"}[24h])",
          "refId": "A"
        }
      ]
