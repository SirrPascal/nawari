      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawari-local-mimir"
          },
          "editorMode": "code",
          "expr": "time() - timestamp(netdata_nawari_network_latency{instance=~\"^$instance$\", dimension=\"gateway\"})",
          "instant": true,
          "legendFormat": "Telemetry Ingestion Lag",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Telemetry Freshness (Sample Age)",
      "type": "stat",
      "description": "Sample age of the latest telemetry point. Expected collection cadence is 60s (with up to 5s jitter). Values up to 75s indicate normal healthy collection cycles; >75s indicates delayed polling; >150s indicates a stalled or offline collector."
    },
