# Review-only template. Replace the DNS name and provision secrets before activation.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name nawari.example.internal;

    ssl_certificate /run/secrets/nawari_tls_fullchain;
    ssl_certificate_key /run/secrets/nawari_tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_early_data off;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location / {
        proxy_pass http://api:18090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Early-Data "";
    }
}
