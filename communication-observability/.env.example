# ==============================================================================
# NAWARI — Enterprise Network & Communications Observability Platform
# Environment Configuration Template
# COPY TO .env AND FILL IN ACTUAL SECRETS. NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Project & Runtime Environment
COMPOSE_PROJECT_NAME=nawari
NAWARI_ENV=development
NAWARI_LOG_LEVEL=INFO

# Application API
NAWARI_API_PORT=8000
NAWARI_BIND_IP=127.0.0.1
NAWARI_SECRET_KEY=change_this_to_a_secure_random_string

# PostgreSQL Database (Zabbix datastore)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# Zabbix Server & Frontend (7.4)
ZABBIX_IMAGE_TAG=alpine-7.4-latest
ZBX_SERVER_HOST=zabbix-server
ZBX_SERVER_PORT=10051
ZBX_WEB_PORT=8088
ZBX_WEB_BIND_IP=127.0.0.1
ZBX_API_USER=Admin
ZBX_API_PASSWORD=replace_with_zabbix_admin_password
ZBX_API_TOKEN=

# SNMP Traps Receiver
SNMP_TRAP_PORT=162
SNMP_TRAP_BIND_IP=0.0.0.0

# Grafana (v11.6+ required for modern alexanderzobnin-zabbix-app plugin)
GRAFANA_IMAGE_TAG=11.6.0
GRAFANA_PORT=3001
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password

# Avaya SBCE Telemetry (Runtime credentials; never committed to git)
AVAYA_SBCE_HOST=10.2.156.131
AVAYA_SBCE_SNMP_PORT=161
AVAYA_SBCE_SNMP_SEC_NAME=Admin
AVAYA_SBCE_SNMP_AUTH_PASS=replace_with_sbce_auth_phrase
AVAYA_SBCE_SNMP_PRIV_PASS=replace_with_sbce_priv_phrase
AVAYA_SBCE_SNMP_AUTH_PROTO=SHA
AVAYA_SBCE_SNMP_PRIV_PROTO=DES

# Asterisk Voice Assurance (Deferred profile; disabled by default)
ASTERISK_IMAGE_TAG=22.11.0
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=nawari
ASTERISK_AMI_SECRET=replace_with_ami_secret
AVTEST_SOURCE_IP=10.2.1.58
SIP_USERNAME=4059
SIP_PASSWORD=replace_with_sip_password
SIP_REALM=kq.kenya-airways.com
SIP_DESTINATION=2398
LIVE_CALLS_ENABLED=false
AUTOMATION_ENABLED=false

# ==============================================================================
# Microsoft 365 Email Alert Notifications (Phase 13.3)
# ==============================================================================
# SMTP Server & Port (Mandatory STARTTLS negotiation on port 587)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false

# Authentication credentials (Leave empty until formal administrative handoff)
# Email delivery remains disabled until credentials/tokens are provided.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Modern Authentication Option (BASIC vs OAUTH2)
SMTP_AUTH_MODE=BASIC
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Master delivery enable switch (Defaults to false for safety)
SMTP_DELIVERY_ENABLED=false

