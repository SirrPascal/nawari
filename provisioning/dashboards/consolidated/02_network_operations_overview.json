          "datasource": {
            "type": "postgres",
            "uid": "nawari-postgres-telemetry"
          },
          "description": "Interactive Layer 2 and Layer 3 topological graph displaying confirmed switches, routers, SBCs, endpoints, and links with real-time operational status and bandwidth. Missing data indicates collector outage, agent failure, or network disruption; values are preserved as null gaps.",
          "gridPos": {
            "h": 16,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "id": 16,
          "options": {
            "nodes": {
              "mainStatUnit": "none",
              "secondaryStatUnit": "none"
            },
            "edges": {
              "mainStatUnit": "bps",
              "secondaryStatUnit": "none"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "nawari-postgres-telemetry"
              },
              "format": "table",
              "rawSql": "SELECT device_id AS id, canonical_name AS title, vendor || ' ' || COALESCE(model, '') AS \"subTitle\", CASE WHEN confidence_score >= 0.95 THEN 'CONFIRMED' ELSE 'INFERRED' END AS \"mainStat\", site_id AS \"secondaryStat\", CASE WHEN confidence_score >= 0.95 THEN 'green' ELSE 'orange' END AS color FROM topology_devices;",
              "refId": "nodes"
            },
            {
              "datasource": {
                "type": "postgres",
                "uid": "nawari-postgres-telemetry"
              },
              "format": "table",
              "rawSql": "SELECT l.link_id AS id, src_if.device_id AS source, dst_if.device_id AS target, COALESCE(src_if.speed_bps, 1000000000) AS \"mainStat\", l.discovery_protocol AS \"secondaryStat\", CASE WHEN l.status = 'ACTIVE' THEN 'green' ELSE 'red' END AS color FROM topology_layer2_links l JOIN topology_interfaces src_if ON src_if.interface_id = l.source_interface_id JOIN topology_interfaces dst_if ON dst_if.interface_id = l.target_interface_id;",
              "refId": "edges"
            }
          ],
          "title": "Enterprise Network Topology (Node Graph)",
          "type": "nodeGraph"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "nawari-postgres-telemetry"
          },
          "description": "Chronological audit log of physical link transitions, neighbor additions/losses, and route modifications detected by the topology engine. Missing data indicates collector outage, agent failure, or network disruption; values are preserved as null gaps.",
